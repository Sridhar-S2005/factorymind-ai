# Live sensor stream
LIVE_STREAM_URL=https://unviable-trickily-broadband.ngrok-free.dev/stream
CSV_PATH=../data/factorymind_sensor_data.csv

# MySQL connection settings
# Create this database in MySQL Workbench: CREATE DATABASE IF NOT EXISTS factorymind_ai;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=factorymind_ai

# Manager email report (SMTP). Configure with your approved email provider.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# For Gmail, use an App Password rather than your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_sender_email@gmail.com
# Optional default recipient (the UI also allows entering a manager address)
MANAGER_EMAIL=manager@example.com
