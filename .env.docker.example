# ==============================================================
# FactoryMind AI — Production & Docker Environment Variables
# ==============================================================

# Port configuration
FRONTEND_PORT=80

# Live sensor SSE stream
LIVE_STREAM_URL=https://unviable-trickily-broadband.ngrok-free.dev/stream

# MySQL Database credentials
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=factorymind_ai
MYSQL_PORT=3306

# Allowed CORS origins (comma-separated list, or * to permit all)
ALLOWED_ORIGINS=*

# Manager Email / Alerting (SMTP)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_sender_email@gmail.com
MANAGER_EMAIL=manager@example.com
